{
  "name": "otpforwarder-pc",
  "productName": "OTP 미러링",
  "version": "1.0.1",
  "description": "세컨드폰 미러링 + 텔레그램 포워딩 자동 전환",
  "main": "main.js",
  "author": "Boss",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.boss.otpforwarderpc",
    "productName": "OTP 미러링",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/scrcpy",
        "to": "scrcpy"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "OtpMirror_Setup_v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OTP 미러링"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cirross2",
        "repo": "OtpForwarderPC"
      }
    ]
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
